
% Water Jug Problem (4-litre and 3-litre jugs)

move((A,B),(4,B)) :- A < 4.
move((A,B),(A,3)) :- B < 3.
move((A,B),(0,B)) :- A > 0.
move((A,B),(A,0)) :- B > 0.

% Pour water from 4-litre jug to 3-litre jug
move((A,B),(A2,B2)) :-
    T is min(A,3-B),
    A2 is A-T,
    B2 is B+T.

% Pour water from 3-litre jug to 4-litre jug
move((A,B),(A2,B2)) :-
    T is min(B,4-A),
    A2 is A+T,
    B2 is B-T.

% Goal state
goal((2,0)).

% Find path
path(S,P) :-
    path(S,[S],P).

path(S,_,[S]) :-
    goal(S).

path(S,V,[S|P]) :-
    move(S,N),
    \+ member(N,V),
    path(N,[N|V],P).

