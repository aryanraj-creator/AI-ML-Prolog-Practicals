astar(Start, Goal, Path) :-
    h(Start, H),
    search([(H, 0, Start, [Start])], Goal, RevPath),
    reverse(RevPath, Path).

search([(_, _, Goal, Path)|_], Goal, Path).

search([(_, G, Node, Path)|Rest], Goal, FinalPath) :-
    findall(
        (F, NewG, Next, [Next|Path]),
        (
            edge(Node, Next, C),
            \+ member(Next, Path),
            NewG is G + C,
            h(Next, H),
            F is NewG + H
        ),
        Children
    ),
    append(Rest, Children, NewList),
    sort(NewList, SortedList),
    search(SortedList, Goal, FinalPath).

